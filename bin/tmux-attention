#!/usr/bin/env bash
# One navigator and pane-state CLI. Supporting files stay beside the installed
# bin/ directory; follow executable symlinks without GNU readlink -f (macOS).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  BASE="$(CDPATH= cd -P "$(dirname "$SOURCE")" && pwd)" || exit 1
  SOURCE="$(readlink "$SOURCE")" || exit 1
  case "$SOURCE" in /*) ;; *) SOURCE="$BASE/$SOURCE" ;; esac
done
CURRENT_DIR="$(CDPATH= cd -P "$(dirname "$SOURCE")/.." && pwd)" || exit 1
# shellcheck source=../scripts/helpers.sh
source "$CURRENT_DIR/scripts/helpers.sh"

usage() {
  cat <<'EOF'
usage: tmux-attention [directory]
       tmux-attention <state|clear|toggle> [pane_id]
       tmux-attention run [--] <command> [args...]

  (no arguments)      navigate sessions, panes and directories on a terminal
  directory           create/reuse its session; use . for the current directory
  -- directory        treat a reserved name (such as run) as a directory

  working  [pane_id]   process started/resumed running
  blocked  [pane_id]   process needs input/approval (seen rule applies)
  failed   [pane_id]   process finished unsuccessfully (seen rule applies)
  done     [pane_id]   process finished (seen rule applies)
  idle     [pane_id]   process quiesced and nothing is pending
  unknown  [pane_id]   integration cannot classify the state
  clear    [pane_id]   remove tracking entirely
  toggle   [pane_id]   manually mark/unmark, bypassing the seen rule
  run [--] <command>   working -> run command -> done/failed
  -h, --help          show this help
  --version           show the installed version

Navigation switches the client inside tmux and attaches outside it. With no
sessions, the navigator starts with directories; otherwise it starts with
sessions. Shift-tab cycles sessions -> panes -> directories -> sessions.
Bare invocation without a terminal prints usage and exits 1.

pane_id defaults to $TMUX_PANE. Outside tmux state commands are silent no-ops;
run still executes its command and preserves its exit code. Seen-rule hooks and
native icon formats initialize automatically. Use #{T:@attention_session} (or
pane/window/global) in your tmux theme; @attention_icon_<state> overrides an icon.
No setup command is needed. Key bindings are configured directly in tmux.conf.
EOF
}

usage_error() {
  printf 'tmux-attention: %s\n' "$1" >&2
  usage >&2
  exit 1
}

# A notifying state applies the seen rule and preserves unanswered blocked.
record() {
  local pane="$1" state="$2"
  if pane_focused "$pane"; then
    set_pane_state "$pane" idle
    return 0
  fi
  if [ "$(pane_state "$pane")" = blocked ]; then
    case "$state" in done | failed) return 0 ;; esac
  fi
  set_pane_state "$pane" "$state"
}

cmd="${1:-}"
case "$cmd" in
  -h | --help)
    [ "$#" -eq 1 ] || usage_error '--help takes no arguments'
    usage
    exit 0
    ;;
  --version)
    [ "$#" -eq 1 ] || usage_error '--version takes no arguments'
    IFS= read -r version < "$CURRENT_DIR/VERSION" || exit 1
    printf 'tmux-attention %s\n' "$version"
    exit 0
    ;;
  run)
    shift
    [ "${1:-}" = '--' ] && shift
    [ "$#" -gt 0 ] || usage_error 'run requires a command'
    pane="${TMUX_PANE:-}"
    if [ -z "${TMUX:-}" ] || [ -z "$pane" ] ||
      ! tmux display-message -p -t "$pane" '' >/dev/null 2>&1; then
      "$@"
      exit "$?"
    fi
    # Tracking must never prevent the wrapped command from running.
    ensure_server_hooks
    set_pane_state "$pane" working
    "$@"
    rc="$?"
    if [ "$rc" -eq 0 ]; then record "$pane" done; else record "$pane" failed; fi
    exit "$rc"
    ;;
  working | blocked | failed | done | idle | unknown | clear | toggle)
    [ "$#" -le 2 ] || usage_error "$cmd accepts at most one pane_id"
    [ -n "${TMUX:-}" ] || exit 0
    pane="${2:-${TMUX_PANE:-}}"
    [ -n "$pane" ] || exit 0
    tmux display-message -p -t "$pane" '' >/dev/null 2>&1 || exit 0
    ensure_server_hooks || exit 1
    case "$cmd" in
      working | idle | unknown) set_pane_state "$pane" "$cmd" ;;
      blocked | failed | done) record "$pane" "$cmd" ;;
      clear) clear_pane_state "$pane" ;;
      toggle)
        case "$(pane_state "$pane")" in
          done | failed) set_pane_state "$pane" idle ;;
          *) set_pane_state "$pane" done ;;
        esac
        ;;
    esac
    exit 0
    ;;
  '')
    [ "$#" -eq 0 ] || usage_error 'directory must not be empty'
    if ! [ -t 0 ] || ! [ -t 1 ]; then usage >&2; exit 1; fi
    attention_require tmux || exit 1
    if tmux list-sessions >/dev/null 2>&1; then
      exec "$CURRENT_DIR/scripts/picker.sh"
    else
      exec "$CURRENT_DIR/scripts/new-session.sh"
    fi
    ;;
  --)
    shift
    [ "$#" -eq 1 ] && [ -n "$1" ] || usage_error '-- requires one directory'
    ;;
  -*) usage_error "unknown option: $cmd" ;;
  *) [ "$#" -eq 1 ] || usage_error 'expected one directory' ;;
esac

# Explicit directories do not need fzf. Prefix reserved names with ./ or --.
attention_require tmux || exit 1
exec "$CURRENT_DIR/scripts/new-session.sh" -- "$1"
